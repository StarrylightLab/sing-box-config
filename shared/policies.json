  "node_filters": {
    "香港优选": {
      "include": "🇭🇰|香港|Hong[ -]?Kong|\\bHK\\b"
    },
    "台湾优选": {
      "include": "🇹🇼|台湾|台灣|Taiwan|\\bTW\\b"
    },
    "新加坡优选": {
      "include": "🇸🇬|新加坡|狮城|獅城|Singapore|\\bSG\\b"
    },
    "日本优选": {
      "include": "🇯🇵|日本|Japan|\\bJP\\b"
    },
    "美国优选": {
      "include": "🇺🇸|美国|美國|United[ -]?States|\\bUS\\b"
    },
    "其他地区优选": {
      "exclude": "(?:🇭🇰|香港|Hong[ -]?Kong|\\bHK\\b)|(?:🇹🇼|台湾|台灣|Taiwan|\\bTW\\b)|(?:🇸🇬|新加坡|狮城|獅城|Singapore|\\bSG\\b)|(?:🇯🇵|日本|Japan|\\bJP\\b)|(?:🇺🇸|美国|美國|United[ -]?States|\\bUS\\b)"
    }
  },
