{
  "log": {
    "level": "info",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "type": "local",
        "tag": "dns-local",
        "prefer_go": true
      },
      {
        "type": "https",
        "tag": "dns-direct",
        "server": "223.5.5.5",
        "path": "/dns-query",
        "tls": {
          "server_name": "dns.alidns.com"
        },
        "detour": "direct"
      },
      {
        "type": "https",
        "tag": "dns-proxy",
        "server": "1.1.1.1",
        "path": "/dns-query",
        "tls": {
          "server_name": "cloudflare-dns.com"
        },
        "detour": "proxy"
      },
      {
        "type": "fakeip",
        "tag": "dns-fakeip",
        "inet4_range": "198.19.0.0/16"
      },
      {
        "type": "hosts",
        "tag": "dns-hosts",
        "predefined": {
          "doh.pub": [
            "1.12.12.21",
            "120.53.53.53"
          ]
        }
      }
    ],
    "rules": [],
    "final": "dns-direct",
    "strategy": "prefer_ipv6",
    "reverse_mapping": true,
    "cache_capacity": 8192,
    "optimistic": {
      "enabled": true
    }
  },
  "route": {
    "default_http_client": "rules-direct",
    "auto_detect_interface": true,
    "default_domain_resolver": {
      "server": "dns-direct",
      "strategy": "prefer_ipv6"
    },
    "rules": [
      {
        "action": "sniff",
        "sniffer": [
          "http",
          "tls",
          "quic",
          "dns"
        ]
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "port": 53
          },
          {
            "protocol": "dns"
          }
        ],
        "action": "hijack-dns"
      }
    ],
    "rule_set": [],
    "final": "漏网之鱼"
  },
  "experimental": {
    "cache_file": {
      "enabled": true
    }
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "address": [
        "172.19.0.1/30",
        "fdfe:dcba:9876::1/126"
      ],
      "auto_route": true,
      "strict_route": true
    },
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "0.0.0.0",
      "listen_port": 7897
    }
  ],
  "http_clients": [
    {
      "tag": "rules-direct",
      "detour": "direct"
    }
  ]
}
